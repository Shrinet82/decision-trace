# Frontend (Vite). Copy to frontend/.env.local; none of these is a secret.

# Serve recorded fixtures instead of calling an API. default: true on localhost, false in production
VITE_USE_MOCKS=
# Backend base URL. default: http://localhost:8000 in dev, /api in production (Cloudflare proxy)
VITE_API_BASE_URL=
# MCP endpoint shown on the /agents page
VITE_MCP_URL=
