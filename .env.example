# FalkorDB Cloud Settings
FALKORDB_HOST=your-falkordb-host.falkordb.cloud
FALKORDB_PORT=6379
FALKORDB_USERNAME=falkordb
FALKORDB_PASSWORD=your-falkordb-password
FALKORDB_GRAPH_NAME=company_brain

# LLM Configuration (OpenAI-compatible endpoint for Qwen/OpenAI/etc.)
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=qwen/qwen3.8-27b
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=

# Vector & Memory Storage
# Vectors stored in local LanceDB to conserve 100MB FalkorDB free tier
VECTOR_DB_PROVIDER=lancedb
LANCEDB_PATH=.lancedb

# Backend & Security
FRONTEND_ORIGIN=http://localhost:5173
ADMIN_TOKEN=change-this-secret-admin-token
PORT=8000
HOST=0.0.0.0
