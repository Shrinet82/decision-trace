# Copy to .env and fill in. Nothing here is a real credential.
# Required variables are uncommented and empty. Optional ones are commented out and show their
# default: uncomment one only to change it (an empty value is read as "set to empty", not unset).

# --- FalkorDB (required) ---------------------------------------------------------------------
# FalkorDB Cloud (the free tier works) or a local container, see README "Run locally".
FALKORDB_HOST=
FALKORDB_PASSWORD=
# FALKORDB_PORT=6379
# FALKORDB_USERNAME=falkordb          # use "default" for a local container started with --requirepass
# Name of the graph the app reads and writes, and the dataset name that maps to it:
# FALKORDB_GRAPH_NAME=c87aa0cf-1c09-5296-8518-a3e8b9a1e744
# DATASET_NAME=c87aa0cf-1c09-5296-8518-a3e8b9a1e744   # defaults to FALKORDB_GRAPH_NAME

# --- Language model (required: one of the two setups; must be non-empty even to just browse) ---
# A) Amazon Bedrock (default model bedrock/deepseek.v3.2): put the Bedrock API key in both
#    BEDROCK_API_KEY and LLM_API_KEY.
LLM_API_KEY=
# BEDROCK_API_KEY=
# AWS_REGION_NAME=us-east-1
# BEDROCK_MODEL=bedrock/deepseek.v3.2
# B) Any OpenAI-compatible endpoint (Groq, OpenRouter, ...): USE_GROQ=1 ignores Bedrock.
# USE_GROQ=1
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=groq/llama-3.3-70b-versatile      # LiteLLM model id with provider prefix
# SECONDARY_GROQ_API_KEY=                     # optional second key; extraction rotates to it on rate limits

# --- Embeddings and vectors (local, no key needed) -------------------------------------------
# EMBEDDING_PROVIDER=fastembed
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# VECTOR_DB_PROVIDER=lancedb
# LANCEDB_PATH=.lancedb
# SYSTEM_ROOT_DIRECTORY=~/.cognee_system
# DATA_ROOT_DIRECTORY=~/.cognee_data

# --- API server ------------------------------------------------------------------------------
# FRONTEND_ORIGIN=http://localhost:5173
# HOST=0.0.0.0
# PORT=8000
# LOG_LEVEL=INFO
# ADMIN_TOKEN=                                # token for the admin endpoints (disabled on production)

# --- Public-demo guards ----------------------------------------------------------------------
# Daily LLM budget in estimated tokens across Ask, intent fallback and ingest; 0 = unlimited.
# LLM_DAILY_TOKEN_BUDGET=300000
# true disables the MCP add_source tool.
# MCP_READ_ONLY=false

# --- Evaluation and tests --------------------------------------------------------------------
# BYPASS_EXTRACTION_CACHE=1                   # ignore the extraction cache in scripts/evaluate_holdout*.py
# RUN_INTEGRATION_TESTS=1                     # run the live integration tests (pytest -m integration)
