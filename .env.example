# Copy to .env and fill in. Values are intentionally empty: nothing here is a real credential.
# Lines starting with "# default:" show what the code uses when the variable is not set.

# --- FalkorDB (required) ---------------------------------------------------------------------
# FalkorDB Cloud (free tier works) or a local container, see README "Run locally".
FALKORDB_HOST=
# default: 6379
FALKORDB_PORT=
# default: falkordb  (use "default" for a local container started with --requirepass)
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
# Name of the graph the app reads and writes. default: c87aa0cf-1c09-5296-8518-a3e8b9a1e744
FALKORDB_GRAPH_NAME=
# Dataset name that maps to that graph. default: the same as FALKORDB_GRAPH_NAME
DATASET_NAME=

# --- Language model (one of the two setups) --------------------------------------------------
# A) Amazon Bedrock (the default model is bedrock/deepseek.v3.2)
BEDROCK_API_KEY=
# default: us-east-1
AWS_REGION_NAME=
# default: bedrock/deepseek.v3.2
BEDROCK_MODEL=
# B) Any OpenAI-compatible endpoint (Groq, OpenRouter, ...). Set USE_GROQ=1 to ignore Bedrock.
USE_GROQ=
LLM_API_KEY=
# default: https://api.groq.com/openai/v1
LLM_BASE_URL=
# LiteLLM model id with provider prefix, for example groq/llama-3.3-70b-versatile
LLM_MODEL=
# Optional second key; the extractor rotates to it when the first is rate limited
SECONDARY_GROQ_API_KEY=

# --- Embeddings and vectors (local, no key needed) -------------------------------------------
# default: fastembed
EMBEDDING_PROVIDER=
# default: BAAI/bge-small-en-v1.5
EMBEDDING_MODEL=
# default: lancedb
VECTOR_DB_PROVIDER=
# default: .lancedb
LANCEDB_PATH=
# default: ~/.cognee_system and ~/.cognee_data
SYSTEM_ROOT_DIRECTORY=
DATA_ROOT_DIRECTORY=

# --- API server ------------------------------------------------------------------------------
# default: http://localhost:5173
FRONTEND_ORIGIN=
# default: 0.0.0.0 and 8000
HOST=
PORT=
# default: INFO
LOG_LEVEL=
# Token for the (disabled on production) admin endpoints. Set your own.
ADMIN_TOKEN=

# --- Public-demo guards ----------------------------------------------------------------------
# Daily LLM budget in estimated tokens across Ask, intent fallback and ingest; 0 = unlimited.
# default: 300000
LLM_DAILY_TOKEN_BUDGET=
# true disables the MCP add_source tool. default: false
MCP_READ_ONLY=

# --- Evaluation and tests --------------------------------------------------------------------
# 1 = ignore the extraction cache in scripts/evaluate_holdout*.py
BYPASS_EXTRACTION_CACHE=
# 1 = run the live integration tests (pytest -m integration)
RUN_INTEGRATION_TESTS=
